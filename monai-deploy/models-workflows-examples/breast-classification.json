{
  "name": "ai-breast-density-classification",
  "version": "1.0.0",
  "description": "AI breast density classification",
  "informatics_gateway": {
    "ae_title": "MONAI-DEPLOY",
    "data_origins": [
      "ORTHANC"
    ],
    "export_destinations": [
      "ORTHANC"
    ]
  },
  "tasks": [
    {
      "id": "router",
      "description": "Ensure series modality is MG",
      "type": "router",
      "task_destinations": [
        {
          "name": "breast",
          "conditions": [
            "{{ context.dicom.series.any('0008', '0060')}} == 'MG'"
          ]
        }
      ]
    },
    {
      "id": "breast",
      "description": "Execute Breast Density Classification MAP",
      "type": "docker",
      "args": {
        "container_image": "ghcr.io/mmelqin/monai_ai_breast_density_cls_app:1.0",
        "server_url": "unix:///var/run/docker.sock",
        "entrypoint": "/bin/bash,-c",
        "command": "python3 -u /opt/monai/app/app.py",
        "task_timeout_minutes": "10",
        "temp_storage_container_path": "/var/lib/mde/",
        "env_CUDA_VISIBLE_DEVICES": " ",
        "env_NVIDIA_VISIBLE_DEVICES": " ",
        "env_MONAI_INPUTPATH": "/var/monai/input/",
        "env_MONAI_OUTPUTPATH": "/var/monai/output/",
        "env_MONAI_MODELPATH": "/opt/monai/models/",
        "env_MONAI_WORKDIR": "/var/monai/"
      },
      "artifacts": {
        "input": [
          {
            "name": "env_MONAI_INPUTPATH",
            "value": "{{ context.input.dicom }}"
          }
        ],
        "output": [
          {
            "name": "env_MONAI_OUTPUTPATH",
            "mandatory": true
          }
        ]
      },
      "task_destinations": [
        {
          "name": "export-breast-density-cls"
        }
      ]
    },
    {
      "id": "export-breast-density-cls",
      "description": "Export Classification Storage Object",
      "type": "export",
      "export_destinations": [
        {
          "Name": "ORTHANC"
        }
      ],
      "artifacts": {
        "input": [
          {
            "name": "export-dicom",
            "value": "{{ context.executions.breast.artifacts.env_MONAI_OUTPUTPATH }}",
            "mandatory": true
          }
        ],
        "output": []
      }
    }
  ]
}
