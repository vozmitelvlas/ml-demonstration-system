name: "tinycov_model"
platform: "onnxruntime_onnx"
max_batch_size: 0
input [
  {
    name: "input"
    data_type: TYPE_FP32
    dims: [-1, 1, -1]  # batch_size, channels, signal_length
  }
]
output [
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [-1, 5]  # batch_size, num_classes
  }
]
instance_group [
  {
    kind: KIND_CPU
    count: 1
  }
]